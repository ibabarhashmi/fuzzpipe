{
  "fuzzing": {
    "workers": 8,
    "testLimit": 300000,
    "callSequenceLength": 64,
    "corpusDirectory": ".fuzzpipe/corpus/medusa",
    "deploymentOrder": [
      "CryticTester"
    ],
    "targetContracts": [
      "CryticTester"
    ],
    "testChainConfig": {
      "codeSizeCheckDisabled": true
    }
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": {
      "target": "test/recon/CryticTester.sol",
      "solcVersion": ""
    }
  },
  "testing": {
    "stopOnFailedTest": true,
    "testAllContracts": false,
    "assertionTesting": {
      "enabled": true
    },
    "propertyTesting": {
      "enabled": true,
      "testPrefix": "property_"
    },
    "optimizationTesting": {
      "enabled": false
    }
  }
}