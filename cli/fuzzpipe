def cmd_doctor(args):
    info("Checking fuzzing toolchain (every probe guarded - this never crashes on a missing tool)...")
    missing = []
    for name, (binary, install) in TOOLS.items():
        if have(binary):
            ok("%-16s found (%s)" % (name, shutil.which(binary)))
        else:
            warn("%-16s MISSING" % name)
            missing.append((name, install))
    print()
    print(c("Runtime support matrix (the single source of truth):", "bold"))
    for rt, need, note in SUPPORT_MATRIX:
        print("  %-26s %-42s %s" % (rt, need, note))
    # Hardhat 3 needs crytic-compile >= 0.4 - GUARDED version check (Q1 fix)
    cc = _crytic_compile_version()
    if cc:
        try:
            ok_hh3 = tuple(int(x) for x in cc.split(".")[:2]) >= (0, 4)
        except Exception:
            ok_hh3 = False
        if ok_hh3:
            print(c("  Hardhat v2 AND v3 supported (crytic-compile %s >= 0.4)." % cc, "green"))
        else:
            print(c("  Hardhat v2 supported. For v3 upgrade crytic-compile (have %s, need >= 0.4): "
                    "pip install --upgrade 'crytic-compile>=0.4'" % cc, "yellow"))
    else:
        print(c("  crytic-compile absent - install it (>= 0.4) for Medusa/Echidna and Hardhat v3.", "yellow"))
    print()
    if missing:
        warn("Missing tools - install commands:")
        for name, install in missing:
            print("  %s: %s" % (c(name, "bold"), install))
        print()
        info("Skills-only setup is fine for design work. Install tools before Stage 1+.")
    else:
        ok("All tools present. Ready for the full pipeline (Foundry + Hardhat v2/v3).")
    # doctor is a diagnosis, not a gate: exit 0 always (a missing OPTIONAL tool is not an error)
    return 0


