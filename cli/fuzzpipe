def _ensure_chimera_lib(target, offline=False):
    """Vendor Chimera (+ setup-helpers). Network failures are NON-FATAL (Q5): print the exact
    manual fallback and continue so an offline user is never hard-blocked. Returns True if the
    lib is present, False if it is missing (caller decides whether to proceed)."""
    have_lib = (target / "lib" / "chimera").exists()
    if not have_lib:
        if offline:
            warn("--offline: skipping Chimera vendoring. If lib/chimera is absent, install it "
                 "manually when you have network:")
            print("  cd %s && forge install Recon-Fuzz/chimera" % target)
            return (target / "lib" / "chimera").exists()
        if have("forge"):
            code, _ = run_cmd(["forge", "install", "Recon-Fuzz/chimera", "--no-git"], cwd=str(target))
            if code != 0:
                code, _ = run_cmd(["forge", "install", "Recon-Fuzz/chimera"], cwd=str(target))
        else:
            code, _ = run_cmd(["git", "clone", "--depth", "1",
                               "https://github.com/Recon-Fuzz/chimera", "lib/chimera"], cwd=str(target))
        if code != 0 or not (target / "lib" / "chimera").exists():
            warn("could not vendor Recon-Fuzz/chimera (offline or network error). NON-FATAL - "
                 "scaffold continues; vendor it manually before `build`:")
            print("  cd %s && forge install Recon-Fuzz/chimera" % target)
            print("  (or) git clone --depth 1 https://github.com/Recon-Fuzz/chimera lib/chimera")
            return False
    if not (target / "lib" / "setup-helpers").exists() and not offline:
        if have("forge"):
            run_cmd(["forge", "install", "Recon-Fuzz/setup-helpers", "--no-git"], cwd=str(target))
        else:
            run_cmd(["git", "clone", "--depth", "1",
                     "https://github.com/Recon-Fuzz/setup-helpers", "lib/setup-helpers"], cwd=str(target))
    return True


def _ensure_remappings(target):
    remap = target / "remappings.txt"
    lines = remap.read_text().splitlines() if remap.exists() else []
    wanted = [("@chimera/", "@chimera/=lib/chimera/src/"),
              ("@recon/", "@recon/=lib/setup-helpers/src/"),
              ("forge-std/", "forge-std/=lib/forge-std/src/")]
    for prefix, line in wanted:
        if not any(l.startswith(prefix) for l in lines):
            lines.append(line)
    remap.write_text("\n".join(lines) + "\n")


