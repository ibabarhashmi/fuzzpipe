# ------------------------------------------------ gen-handlers (ABI-driven complete call surface)
# Root cause of low coverage: the scaffold writes an EMPTY TargetFunctions.sol, so the fuzzer only
# ever calls the handful of handlers the skill hand-wrote per invariant. This generates a COMPLETE
# handler surface from the ABI of every in-scope deployed target, decoupling coverage from invariant
# count. Mechanical only; the rendering lives in the `handlers` module.


def _infer_src(target, pt, override):
    """Best-effort source dir for the surface scan: honor --src, else src/ (Foundry) or contracts/."""
    if override:
        return override
    if (Path(target) / "src").is_dir():
        return None                       # _src_dirs default handles it
    if (Path(target) / "contracts").is_dir():
        return "contracts"
    return None


def _scope_contracts(target):
    """Contract names declared in-scope via scope.txt (basename stems). Empty set if no scope.txt —
    the caller then treats every deployed instance as in-scope."""
    f = Path(target) / "scope.txt"
    names = set()
    if f.exists():
        for line in f.read_text().splitlines():
            line = line.strip()
            if line.endswith(".sol"):
                names.add(Path(line).stem)
    return names


def _discover_instances(target, pt):
    """Map a deployed contract TYPE -> its Setup variable name, by scanning Setup.sol for typed
    declarations (`UpsideProtocol internal protocol;`) and constructions (`x = new UpsideProtocol(`).
    This binds an ABI (keyed by type) to the harness variable the generated handlers must call."""
    setup = _recon_dir(target, pt) / "Setup.sol"
    inst = {}
    if not setup.exists():
        return inst
    text = setup.read_text(errors="replace")
    text = _re_mod.sub(r"/\*.*?\*/", " ", text, flags=_re_mod.S)
    text = "\n".join(ln[:ln.find("//")] if "//" in ln else ln for ln in text.splitlines())
    for m in _re_mod.finditer(r"\b([A-Z]\w*)\s+(?:internal|public|private)?\s*(\w+)\s*;", text):
        inst.setdefault(m.group(1), m.group(2))
    for m in _re_mod.finditer(r"(\w+)\s*=\s*new\s+([A-Z]\w*)\s*\(", text):
        inst.setdefault(m.group(2), m.group(1))
    return inst


def _manual_handler_names(target, pt):
    """handler_* already defined in the skill-authored TargetFunctions.sol — these win, so the
    generated surface skips them (MANUAL-OVERRIDE) to avoid duplicate-definition compile errors."""
    tf = _recon_dir(target, pt) / "TargetFunctions.sol"
    if not tf.exists():
        return set()
    return set(_re_mod.findall(r"function\s+(handler_\w+)\s*\(", tf.read_text(errors="replace")))


def _ensure_auto_in_chain(target, pt):
    """Splice TargetFunctionsAuto between the skill's TargetFunctions and Properties, WITHOUT
    touching any hand-written handler body. Idempotent. C3 linearization forbids listing both
    Properties and (its child) TargetFunctionsAuto, so we SWAP Properties -> TargetFunctionsAuto in
    the contract header and add the import. Returns True if it changed the file."""
    tf = _recon_dir(target, pt) / "TargetFunctions.sol"
    if not tf.exists():
        return False
    text = tf.read_text(errors="replace")
    if "TargetFunctionsAuto" in text:
        return False                                  # already spliced
    new = _re_mod.sub(
        r"(abstract\s+contract\s+TargetFunctions\s+is\s+[^{]*?)\bProperties\b",
        r"\1TargetFunctionsAuto", text, count=1)
    if new == text:                                   # header didn't name Properties — append instead
        new = _re_mod.sub(r"(abstract\s+contract\s+TargetFunctions\s+is\s+[^{]*?)(\s*\{)",
                          r"\1, TargetFunctionsAuto\2", text, count=1)
    if 'import {TargetFunctionsAuto}' not in new:
        imp = 'import {TargetFunctionsAuto} from "./TargetFunctionsAuto.sol";\n'
        if 'from "./Properties.sol";' in new:
            new = new.replace('from "./Properties.sol";', 'from "./Properties.sol";\n' + imp.rstrip(), 1)
        else:                                          # fall back to right after the pragma line
            new = _re_mod.sub(r"(pragma solidity[^\n]*\n)", r"\1" + imp, new, count=1)
    tf.write_text(new)
    return True


def cmd_gen_handlers(args):
    target = Path(args.target).resolve()
    pt = _project_type(target, getattr(args, "project_type", None))
    recon = _recon_dir(target, pt)
    if not recon.exists():
        err("no recon harness at %s. Run `fuzzpipe scaffold` first." % recon)
        return 1
    instances = _discover_instances(target, pt)
    scoped = _scope_contracts(target)
    manual = _manual_handler_names(target, pt)
    only = getattr(args, "contract", None)
    src_override = _infer_src(target, pt, getattr(args, "src", None))
    _, _, privileged = _scan_solidity_surface(target, pt, src_override)

    report = {}          # name/contract -> status
    handlers = []        # (name, source, status)
    to_gen = {}          # type -> var
    for typ, var in instances.items():
        if only and typ != only:
            continue
        if scoped and typ not in scoped:
            continue                                   # not an in-scope target
        abi = handlers_mod.load_abi(target, typ)
        if not abi:
            report[typ] = "SKIP(no-abi: run `fuzzpipe build` first)"
            continue
        to_gen[typ] = (var, abi)
    for name in sorted(scoped):                        # scoped but never deployed in Setup
        if name not in instances:
            report[name] = "SKIP(not-deployed)"

    multi = len(to_gen) > 1
    for typ in sorted(to_gen):
        var, abi = to_gen[typ]
        for fn in handlers_mod.mutating_functions(abi):
            is_priv = fn["name"] in privileged
            name, src, status = handlers_mod.render_handler(var, fn, multi=multi, privileged=is_priv)
            if name in manual:
                report[name] = "MANUAL-OVERRIDE"
                continue
            handlers.append((name, src, status))
            report[name] = status

    if not to_gen:
        warn("no in-scope deployed target found (need a typed instance in Setup.sol whose contract "
             "is listed in scope.txt and has a built ABI). Nothing generated.")
        _write_gen_report(target, report)
        return 1

    content = handlers_mod.render_auto_file(handlers)
    (recon / "TargetFunctionsAuto.sol").write_text(content)
    spliced = _ensure_auto_in_chain(target, pt)
    _write_gen_report(target, report)

    gen = sum(1 for _, _, s in handlers if s.startswith("GEN"))
    stub = sum(1 for _, _, s in handlers if s.startswith("STUB"))
    ovr = sum(1 for v in report.values() if v == "MANUAL-OVERRIDE")
    ok("Generated %d handler(s) into %s (%d full, %d struct-stub, %d manual-override)."
       % (len(handlers), recon / "TargetFunctionsAuto.sol", gen, stub, ovr))
    if spliced:
        info("Spliced TargetFunctionsAuto into the harness inheritance chain.")
    print(c("\ngen-handlers report (%s)" % target.name, "bold"))
    for name in sorted(report):
        status = report[name]
        color = "green" if status.startswith("GEN") else ("yellow" if "MANUAL" in status else "red")
        print("    [%s] %s" % (c(status, color), name))
    if stub:
        warn("%d struct/tuple handler(s) are STUBS — fill their `_build_*` hook in TargetFunctions.sol "
             "or they contribute no coverage." % stub)
    info("Next: `fuzzpipe build` (recompile), then `verify-harness` and `run`.")
    set_stage(target, "3-gen-handlers", generated=len(handlers), stubs=stub, overrides=ovr)
    return 0


