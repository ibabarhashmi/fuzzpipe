# ------------------------------------------------------------------------------------- console helpers


def c(txt, color):
    codes = {"red": 31, "green": 32, "yellow": 33, "blue": 34, "bold": 1}
    if not sys.stdout.isatty():
        return txt
    return "\033[%dm%s\033[0m" % (codes[color], txt)


def info(msg):  print(c("[fuzzpipe] ", "blue") + msg)
def ok(msg):    print(c("[ok] ", "green") + msg)
def warn(msg):  print(c("[warn] ", "yellow") + msg)
def err(msg):   print(c("[error] ", "red") + msg, file=sys.stderr)


def _augment_path():
    """Discover common tool install dirs even in a clean shell. Idempotent."""
    home = os.path.expanduser("~")
    extra = [os.path.join(home, ".foundry", "bin"), os.path.join(home, "go", "bin"),
             os.path.join(home, ".local", "bin"), os.path.join(home, ".cargo", "bin")]
    parts = os.environ.get("PATH", "").split(os.pathsep)
    for d in extra:
        if os.path.isdir(d) and d not in parts:
            parts.append(d)
    os.environ["PATH"] = os.pathsep.join(parts)


_augment_path()


def have(tool):
    return shutil.which(tool) is not None


def run_cmd(cmd, cwd=None, stream=True, timeout=None):
    """Run a command. Streaming -> (rc, "").  Captured -> (rc, output).  NEVER raises on a
    missing binary (returns proc.RC_MISSING). A timeout kills the child (proc.RC_TIMEOUT)."""
    info("$ " + " ".join(str(x) for x in cmd))
    if stream and timeout is None:
        return proc.run_stream(cmd, cwd=cwd), ""
    return proc.run_bounded(cmd, timeout or 3600, cwd=cwd)


def state_dir(target):
    return Path(target).resolve() / STATE_DIR_NAME


def load_config(target):
    """The higher-level intent file (.fuzzpipe/config.json, seeded from the template at init).
    Returns {} if absent/unreadable — every consumer must fall back to a hard default."""
    f = state_dir(target) / "config.json"
    if not f.exists():
        return {}
    try:
        return json.loads(f.read_text())
    except Exception:
        return {}


# Default Medusa internal worker (goroutine) count. Kept in ONE place so the value the code
# writes and the value the docs advertise cannot drift (guidance/03 + README point here).
DEFAULT_MEDUSA_WORKERS = 8


def _medusa_workers(target, override=None):
    if override:
        return int(override)
    cfg = load_config(target)
    return int((cfg.get("fuzzing") or {}).get("workers") or DEFAULT_MEDUSA_WORKERS)


def _ladder_budgets(target, tier1_override=None):
    """Per-tier wall-clock budgets (seconds). Reads config `budgets`, falls back to defaults,
    and lets an explicit --budget override the tier-1 (fuzzing) budget."""
    cfg = (load_config(target).get("budgets") or {})
    b = {0: int(cfg.get("tier0", 60)),
         1: int(tier1_override or cfg.get("tier1", 600)),
         2: int(cfg.get("tier2", 900))}
    return b


def load_state(target):
    f = state_dir(target) / "state.json"
    return json.loads(f.read_text()) if f.exists() else {}


def save_state(target, state):
    sd = state_dir(target)
    sd.mkdir(parents=True, exist_ok=True)
    state["updated"] = datetime.now(timezone.utc).isoformat()
    (sd / "state.json").write_text(json.dumps(state, indent=2))


def set_stage(target, stage, **extra):
    st = load_state(target)
    st["stage"] = stage
    st.setdefault("history", []).append(
        {"stage": stage, "at": datetime.now(timezone.utc).isoformat(), **extra})
    st.update(extra)
    save_state(target, st)


# --------------------------------------------------------------------------- project-type detection


def _detect_project_type(target):
    target = Path(target)
    has_foundry = (target / "foundry.toml").exists()
    has_hardhat = any((target / ("hardhat.config." + ext)).exists() for ext in ("js", "ts", "cjs"))
    if has_hardhat and not has_foundry:
        return "hardhat"
    if has_hardhat and has_foundry:
        st = load_state(target)
        if st.get("project_type"):
            return st["project_type"]
        return "foundry"
    if has_foundry:
        return "foundry"
    return None


def _project_type(target, override=None):
    if override:
        st = load_state(target)
        st["project_type"] = override
        save_state(target, st)
        return override
    st = load_state(target)
    if st.get("project_type"):
        return st["project_type"]
    pt = _detect_project_type(target)
    if pt:
        st["project_type"] = pt
        save_state(target, st)
    return pt


def _recon_dir(target, pt):
    if pt == "hardhat":
        return Path(target) / "contracts" / "recon"
    return Path(target) / "test" / "recon"


def _hardhat_config_path(target):
    for ext in ("ts", "cjs", "js"):
        p = Path(target) / ("hardhat.config." + ext)
        if p.exists():
            return p
    return None


def _hardhat_major(target):
    pkg = Path(target) / "node_modules" / "hardhat" / "package.json"
    if pkg.exists():
        try:
            return int(json.loads(pkg.read_text()).get("version", "").split(".")[0])
        except Exception:
            return None
    proj = Path(target) / "package.json"
    if proj.exists():
        try:
            data = json.loads(proj.read_text())
            import re as _re
            for sect in ("devDependencies", "dependencies"):
                spec = (data.get(sect) or {}).get("hardhat")
                if spec:
                    m = _re.search(r"(\d+)", spec)
                    if m:
                        return int(m.group(1))
        except Exception:
            pass
    return None


def _crytic_compile_version():
    """crytic-compile version string, or None. GUARDED — never raises when it is absent (Q1)."""
    code, out = proc.run_probe(["crytic-compile", "--version"])
    if code == 0 and out.strip():
        return out.strip().split()[-1]
    return None


