def cmd_verify(args):
    """Run the verdict gate on a single reproducer test already present in the target's Foundry
    project: compile -> re-execute the SPECIFIC break -> require a harm assertion -> CONFIRMED/SUSPECTED."""
    target = Path(args.target).resolve()
    poc_path = Path(args.poc) if args.poc else None
    if poc_path and not poc_path.is_absolute():
        poc_path = target / poc_path
    src = poc_path.read_text() if (poc_path and poc_path.exists()) else ""
    marker = args.marker or (args.ce or "")
    test_name = args.test or "test_repro"
    if not have("forge"):
        err("forge is required for the verdict gate (it re-executes the PoC). Install: " + TOOLS["forge"][1])
        return 2
    v, reason, out = verdict.lower_and_verify(target, src, test_name, marker)
    (state_dir(target) / "poc").mkdir(parents=True, exist_ok=True)
    (state_dir(target) / "poc" / "last_verdict.log").write_text((out or "")[-8000:])
    if v == "CONFIRMED":
        ok("VERDICT: CONFIRMED - %s" % reason)
        set_stage(target, "5-verify", verdict="CONFIRMED", ce=args.ce)
        return 0
    warn("VERDICT: SUSPECTED - %s (never reported as a bug without a re-executing, harm-asserting PoC)." % reason)
    set_stage(target, "5-verify", verdict="SUSPECTED", ce=args.ce, reason=reason)
    return 1


# --------------------------------------------------------------------------- materiality sweep

def _parse_amount(s):
    """Parse an amount as an exact integer, accepting integer-mantissa scientific form ('1e24')."""
    s = str(s).strip().replace("_", "").lower()
    if "e" in s:
        m, _, e = s.partition("e")
        return int(m or "1") * (10 ** int(e))
    return int(s)


def _log_grid(lo, hi):
    """1-2-5 log-spaced magnitudes in [lo, hi], inclusive of both ends. Deterministic."""
    lo, hi = max(1, int(lo)), int(hi)
    hi = max(lo, hi)
    grid, dec = [], 1
    while dec <= hi:
        for mant in (1, 2, 5):
            v = mant * dec
            if lo <= v <= hi:
                grid.append(v)
        dec *= 10
    grid.append(lo)
    grid.append(hi)
    return sorted(set(grid))


def _test_broke(out, test_name):
    """Did `test_name` FAIL (invariant violated) in this forge output? True=broke, False=held,
    None=couldn't tell (e.g. compile error / test not found)."""
    for line in (out or "").splitlines():
        if test_name in line:
            if "[FAIL" in line:
                return True
            if "[PASS" in line:
                return False
    return None


def _materiality_verdict(results, material):
    """results: list of (magnitude, broke). Returns (verdict, exit_code, breaking_magnitudes).
    DUST-ONLY (exit 2) == breaks only BELOW the materiality threshold -> likely a bad invariant."""
    breaking = [m for m, b in results if b is True]
    if not breaking:
        return "HELD", 0, []
    if max(breaking) >= int(material):
        return "MATERIAL", 0, breaking
    return "DUST-ONLY", 2, breaking


def cmd_materiality(args):
    """Replay an invariant reproducer at escalating input scales to separate a REAL bug from a
    dust-only rounding artifact (a BAD-INVARIANT false positive — guidance/07 filter 3).

    The reproducer test must read its per-run amount from an env var (default FUZZPIPE_SWEEP_AMOUNT),
    e.g. `uint256 amount = vm.envOr("FUZZPIPE_SWEEP_AMOUNT", uint256(1));`, run the exploit at that
    amount, and assert the invariant (a revert = the invariant is violated at that scale). It should
    return early (pass) when `amount` is out of usable range so only a genuine violation fails.

    Exit 2 = the invariant breaks ONLY below the materiality threshold -> tighten it (bad invariant)."""
    target = Path(args.target).resolve()
    if not have("forge"):
        err("forge is required for the materiality sweep. Install: " + TOOLS["forge"][1])
        return 2
    lo, hi, material = _parse_amount(args.min), _parse_amount(args.max), _parse_amount(args.material)
    grid = _log_grid(lo, hi)
    info("Materiality sweep of `%s` over %d scales [%d .. %d]; material threshold = %d"
         % (args.test, len(grid), grid[0], grid[-1], material))
    results = []
    for m in grid:
        rc, out = proc.run_bounded(["forge", "test", "--match-test", args.test],
                                   args.budget, cwd=str(target), env={args.env: m})
        broke = _test_broke(out, args.test)
        results.append((m, broke))
        mark = c("BROKE", "red") if broke else (c("held ", "green") if broke is False else c("?    ", "yellow"))
        print("  %-26d %s" % (m, mark))
    verdict, code, breaking = _materiality_verdict(results, material)
    print()
    if verdict == "HELD":
        ok("Invariant HELD at every scale in the sweep — not falsified here.")
    elif verdict == "MATERIAL":
        warn("Invariant BREAKS at a MATERIAL scale (largest break %d >= %d). GENUINE candidate — "
             "triage as a real bug (guidance/04)." % (max(breaking), material))
    else:
        warn("Invariant breaks ONLY below the materiality threshold (largest break %d < %d). This is "
             "the dust-rounding signature of a BAD INVARIANT (false positive): do NOT report it; add a "
             "materiality bound to the invariant (guidance/07 filter 3)." % (max(breaking), material))
    set_stage(target, "5-materiality", test=args.test, verdict=verdict)
    return code


# ------------------------------------------------------------------------------------- ir


import re as _re_mod   # local alias; the file otherwise avoids a module-level re import

_FUNC_HEAD_RE = _re_mod.compile(r"\bfunction\s+(\w+)\s*\(")
_VAR_RE = _re_mod.compile(
    r"\b(?:uint\d*|int\d*|address|bool|bytes\d*|string|mapping\s*\([^)]*\))\s+public\s+"
    r"(?:constant\s+|immutable\s+)?(\w+)")
_PRIV_MODS = ("onlyOwner", "onlyRole", "onlyAdmin", "onlyGovernance", "onlyGovernor",
              "onlyKeeper", "onlyManager", "onlyGuardian", "restricted", "auth")
_SKIP_SRC_PARTS = ("/test/", "/tests/", "/recon/", "/lib/", "/mock", "/mocks/", "/script/",
                   "/node_modules/", "/foundry-repro/")


def _src_dirs(target, pt, override=None):
    if override:
        return [Path(target) / override]
    if pt == "hardhat":
        return [Path(target) / "contracts"]
    return [Path(target) / "src"]


def _iter_functions(text):
    """Yield (name, modifier_tail) for each function, extracting the argument list by BALANCED
    parens so a `returns (...)` clause is not swallowed into the args (which would drop the
    function's visibility from the tail and under-report the surface — a false-pass bug)."""
    for m in _FUNC_HEAD_RE.finditer(text):
        name = m.group(1)
        depth, j = 0, m.end() - 1                      # j at the opening '('
        while j < len(text):
            if text[j] == "(":
                depth += 1
            elif text[j] == ")":
                depth -= 1
                if depth == 0:
                    break
            j += 1
        k, tail = j + 1, []                            # from after ')' to the next '{' or ';'
        while k < len(text) and text[k] not in "{;":
            tail.append(text[k]); k += 1
        yield name, "".join(tail)


def _scan_solidity_surface(target, pt, override=None):
    """Best-effort (regex, no compiler) extraction of the protocol's attack surface:
    state-mutating external/public functions, public state variables, and privileged functions.
    Deliberately mechanical — the CLI never reasons; it just enumerates what the IR must cover."""
    entry_points, state_vars, privileged = set(), set(), set()
    for base in _src_dirs(target, pt, override):
        if not base.is_dir():
            continue
        for sol in base.rglob("*.sol"):
            p = "/" + str(sol).replace("\\", "/").lstrip("/")
            if any(s in p for s in _SKIP_SRC_PARTS):
                continue
            try:
                text = sol.read_text(errors="replace")
            except Exception:
                continue
            # strip comments so a doc-comment like "call the function foo()" cannot create a phantom
            # entry point / state var (which would demand coverage of code that doesn't exist)
            text = _re_mod.sub(r"/\*.*?\*/", " ", text, flags=_re_mod.S)
            text = "\n".join(ln[:ln.find("//")] if "//" in ln else ln for ln in text.splitlines())
            for name, tail in _iter_functions(text):
                if name == "constructor":
                    continue
                if not _re_mod.search(r"\b(external|public)\b", tail):
                    continue
                if _re_mod.search(r"\b(view|pure)\b", tail):
                    continue                              # not a state-mutating entry point
                entry_points.add(name)
                if any(mod in tail for mod in _PRIV_MODS):
                    privileged.add(name)
            for m in _VAR_RE.finditer(text):
                state_vars.add(m.group(1))
    return entry_points, state_vars, privileged


def _ir_referenced_tokens(invs):
    """Every identifier an invariant set 'touches' — target suffixes + predicate/statement tokens —
    so the audit can decide whether a surface element is covered by >= 1 invariant."""
    toks = set()
    auth_toks = set()
    for i in invs:
        local = set()
        for t in (i.targets or []):
            local.add(str(t).split(".")[-1])
            local.add(str(t))
        expr = (i.predicate or {}).get("expr", "") if isinstance(i.predicate, dict) else ""
        for blob in (expr, i.statement or ""):
            local.update(_re_mod.findall(r"[A-Za-z_]\w*", blob))
        toks.update(local)
        if i.shape == "AUTHORIZATION" or i.category == "anti-property":
            auth_toks.update(local)
    return toks, auth_toks


def _load_waivers(target, override=None):
    f = Path(override) if override else (state_dir(target) / "coverage-waivers.json")
    if not f.exists():
        return {}
    try:
        data = json.loads(f.read_text())
        return {k: v for k, v in data.items() if isinstance(v, str) and v.strip()}
    except Exception:
        return {}


def cmd_ir_coverage_audit(args):
    """Machine-enforced completeness gate: every state-mutating entry point / public state var is
    covered by >= 1 IR invariant, and every privileged function has >= 1 AUTHORIZATION/anti-property
    invariant — or carries a justified waiver in .fuzzpipe/coverage-waivers.json. Exit 2 on an
    unwaived gap (the same actionable loop-back signal as `coverage`)."""
    target = Path(args.target).resolve()
    pt = _project_type(target, getattr(args, "project_type", None))
    invs = irmod.load(state_dir(target) / "invariants.json")
    if not invs:
        err("no IR at %s. Author invariants and `fuzzpipe ir put` them first." % (state_dir(target) / "invariants.json"))
        return 1
    entry_points, state_vars, privileged = _scan_solidity_surface(target, pt, getattr(args, "src", None))
    if not entry_points and not state_vars:
        warn("no Solidity surface found under %s — pass --src <dir> if sources live elsewhere."
             % ", ".join(str(d) for d in _src_dirs(target, pt, getattr(args, "src", None))))
        return 1
    toks, auth_toks = _ir_referenced_tokens(invs)
    waivers = _load_waivers(target, getattr(args, "waivers", None))

    gaps = []   # (kind, name)
    for fn in sorted(entry_points):
        if fn not in toks and fn not in waivers:
            gaps.append(("entry-point", fn))
    for v in sorted(state_vars):
        if v not in toks and v not in waivers:
            gaps.append(("state-var", v))
    for fn in sorted(privileged):
        if fn not in auth_toks and fn not in waivers:
            gaps.append(("privileged-no-authz", fn))

    print(c("\nIR coverage audit (%s)" % target.name, "bold"))
    print("  entry points: %d   state vars: %d   privileged: %d   invariants: %d"
          % (len(entry_points), len(state_vars), len(privileged), len(invs)))
    if waivers:
        print("  waived: %s" % ", ".join(sorted(waivers)))
    if not gaps:
        ok("Completeness gate PASSED — every surface element is covered by an invariant or waived.")
        set_stage(target, "2-coverage-audit", gaps=0)
        return 0
    warn("%d coverage GAP(s) — a whole bug class may be invisible to the campaign:" % len(gaps))
    for kind, name in gaps:
        print("    [%s] %s" % (c(kind, "red"), name))
    warn("Fix Stage 2 (add invariants) or record a justified waiver in "
         ".fuzzpipe/coverage-waivers.json ({\"%s\": \"why it is safe to skip\"})." % gaps[0][1])
    set_stage(target, "2-coverage-audit", gaps=len(gaps))
    return 2


def cmd_ir(args):
    target = Path(args.target).resolve()
    path = state_dir(target) / "invariants.json"
    action = args.action
    if action == "coverage-audit":
        return cmd_ir_coverage_audit(args)
    if action == "put":
        if not args.file:
            err("`ir put` needs --file <ir.json>")
            return 1
        raw = json.loads(Path(args.file).read_text())
        raw = raw.get("invariants", raw) if isinstance(raw, dict) else raw
        invs = [irmod.Invariant.from_dict(d) for d in raw]
        errs = irmod.validate(invs)
        if errs:
            err("IR validation failed - not saved:")
            for e in errs:
                print("  - " + e)
            return 1
        irmod.dump(path, invs)
        ok("stored %d invariant(s) to %s" % (len(invs), path))
        return 0
    invs = irmod.load(path)
    if action == "validate":
        errs = irmod.validate(invs)
        if errs:
            err("IR invalid:")
            for e in errs:
                print("  - " + e)
            return 1
        ok("IR valid (%d invariant(s))." % len(invs))
        return 0
    if action == "list":
        for i in invs:
            print("  %-18s [%s/%s/%s] tier%d %-9s %s"
                  % (i.id, i.category, i.shape, i.scope, i.tier_hint, i.status, i.statement[:60]))
        return 0
    if action == "get":
        for i in invs:
            if i.id == args.id:
                print(json.dumps(irmod.asdict(i), indent=2))
                return 0
        err("no invariant with id %s" % args.id)
        return 1
    if action == "candidates":
        for i in invs:
            if i.status == "candidate":
                print("  %-18s %s" % (i.id, i.statement[:70]))
        return 0
    err("unknown ir action: %s" % action)
    return 1


# --------------------------------------------------------------------------------- coverage


def _cov_in_scope(sf):
    """A source path that counts toward protocol coverage (not lib/test/recon/repro). Normalizes so
    a RELATIVE path (`lib/forge-std/...`, emitted by forge coverage) is excluded like an absolute one."""
    if not sf.endswith(".sol"):
        return False
    norm = sf if sf.startswith("/") else "/" + sf
    return not any(s in norm for s in ("/lib/", "/test/", "/contracts/recon/", "/foundry-repro/"))


def _coverage_scan(target, engine):
    """Parse the engine's lcov into in-scope per-file coverage. Returns (scope, err_message):
    scope is {file: {funcs, la, lh}} for in-scope files, or (None, message) when there is no lcov
    or nothing in scope. Shared by `cmd_coverage` and the run-time coverage gate."""
    lcov = state_dir(target) / "corpus" / engine / "coverage" / "lcov.info"
    if not lcov.exists():
        return None, ("no coverage at %s. Run `fuzzpipe run --engine %s` first (coverage must be "
                      "enabled)." % (lcov, engine))
    files, cur = {}, None
    for line in lcov.read_text().splitlines():
        if line.startswith("SF:"):
            cur = line[3:]
            files[cur] = {"funcs": {}, "la": 0, "lh": 0}
        elif line.startswith("FNDA:") and cur:
            hits, name = line[5:].split(",", 1)
            files[cur]["funcs"][name] = int(hits)
        elif line.startswith("DA:") and cur:
            _, cnt = line[3:].split(",")
            files[cur]["la"] += 1
            if int(cnt) > 0:
                files[cur]["lh"] += 1
    scope = {sf: d for sf, d in files.items() if _cov_in_scope(sf)}
    if not scope:
        return None, "no in-scope source files found in coverage (only lib/test)."
    return scope, None


def _uncovered_functions(scope):
    """List of 'file::fn' for every in-scope function with zero hits."""
    out = []
    for sf in sorted(scope):
        name = sf.split("/")[-1]
        for fn, hits in sorted(scope[sf]["funcs"].items()):
            if hits == 0:
                out.append("%s::%s" % (name, fn))
    return out


def _overall_pct(scope):
    la = sum(d["la"] for d in scope.values())
    lh = sum(d["lh"] for d in scope.values())
    return (100 * lh // la) if la else 0


def _cov_waived(entry, waivers):
    """True if a 'file::fn' uncovered entry is waived — by the exact key or by the bare fn name."""
    return entry in waivers or entry.split("::")[-1] in waivers


def _min_pct_config(target):
    """Configured minimum in-scope line-% for the run-time gate (config coverage.min_pct, default 0
    = pct never fails on its own; the gate still blocks on unwaived uncovered entry points)."""
    cov = (load_config(target).get("coverage") or {})
    try:
        return int(cov.get("min_pct") or 0)
    except Exception:
        return 0


def _coverage_gate(target, engine, min_pct, waivers):
    """Evaluate the hard coverage gate. Returns (available, passed, reasons):
      available=False when there is no lcov to judge (caller treats as 'not yet measurable');
      passed=False with reasons when an unwaived entry point is MISS or overall % < min_pct."""
    scope, msg = _coverage_scan(target, engine)
    if scope is None:
        return False, False, [msg]
    reasons = []
    unwaived = [u for u in _uncovered_functions(scope) if not _cov_waived(u, waivers)]
    if unwaived:
        reasons.append("%d uncovered entry point(s): %s"
                       % (len(unwaived), ", ".join(unwaived[:8]) + (" ..." if len(unwaived) > 8 else "")))
    pct = _overall_pct(scope)
    if min_pct and pct < min_pct:
        reasons.append("in-scope line coverage %d%% < required %d%%" % (pct, min_pct))
    return True, (not reasons), reasons


def cmd_coverage(args):
    target = Path(args.target).resolve()
    scope, msg = _coverage_scan(target, args.engine)
    if scope is None:
        # "no in-scope files" is a soft warn; "no lcov" is an error — both exit 1 (no false 'covered')
        (warn if "in-scope" in msg else err)(msg)
        return 1
    gate = getattr(args, "gate", False)
    min_pct = getattr(args, "min_pct", 0) or 0
    waivers = _load_waivers(target, None) if gate else {}
    uncovered = _uncovered_functions(scope)
    print(c("\nCoverage report (%s)" % args.engine, "bold"))
    for sf in sorted(scope):
        d = scope[sf]
        la, lh = d["la"], d["lh"]
        pct = (100 * lh // la) if la else 0
        name = sf.split("/")[-1]
        color = "green" if pct >= 80 else ("yellow" if pct >= 40 else "red")
        print("\n  %s  lines %d/%d (%s)" % (c(name, "bold"), lh, la, c(str(pct) + "%", color)))
        for fn, hits in sorted(d["funcs"].items()):
            waived = gate and _cov_waived("%s::%s" % (name, fn), waivers)
            mark = c("ok ", "green") if hits > 0 else (c("waiv", "yellow") if waived else c("MISS", "red"))
            print("    [%s] %-30s hits=%d" % (mark, fn, hits))
    print()
    overall = _overall_pct(scope)

    if gate:
        unwaived = [u for u in uncovered if not _cov_waived(u, waivers)]
        reasons = []
        if unwaived:
            reasons.append("%d uncovered entry point(s): %s" % (len(unwaived), ", ".join(unwaived)))
        if min_pct and overall < min_pct:
            reasons.append("in-scope line coverage %d%% < required %d%%" % (overall, min_pct))
        if reasons:
            warn("COVERAGE GATE FAILED (%d%% in-scope lines):" % overall)
            for r in reasons:
                print("    - " + r)
            warn("Raise coverage (`fuzzpipe gen-handlers`, loosen clamps) or record a justified "
                 "waiver in .fuzzpipe/coverage-waivers.json, then re-run.")
            set_stage(target, "5-coverage", gate="fail", pct=overall, uncovered=len(unwaived))
            return 2
        ok("COVERAGE GATE PASSED — %d%% in-scope lines, every entry point hit or waived." % overall)
        set_stage(target, "5-coverage", gate="pass", pct=overall, uncovered=0)
        return 0

    # default (non-gate) behavior — unchanged: any uncovered in-scope function is the loop-back signal
    if uncovered:
        warn("%d function(s) NEVER exercised by the campaign:" % len(uncovered))
        for u in uncovered:
            print("    - " + u)
        warn("LOOP-BACK SIGNAL: uncovered entry points mean the harness is incomplete. "
             "Add/loosen handlers (Stage 3) before trusting any 'passed' result.")
        set_stage(target, "5-coverage", uncovered=len(uncovered))
        return 2
    ok("All in-scope functions were exercised. Coverage looks healthy.")
    set_stage(target, "5-coverage", uncovered=0)
    return 0


# --------------------------------------------------------------------------------- status


def cmd_status(args):
    target = Path(args.target).resolve()
    st = load_state(target)
    if not st:
        warn("no run state - run `fuzzpipe init --target <path>` first.")
        return 1
    print(c("fuzzpipe v2.2 status", "bold"))
    print("  target : %s" % target)
    print("  stage  : %s" % st.get("stage", "?"))
    print("  updated: %s" % st.get("updated", "?"))
    invs = irmod.load(state_dir(target) / "invariants.json")
    if invs:
        print("  IR     : %d invariant(s)" % len(invs))
    for h in st.get("history", [])[-8:]:
        print("    - %s  %s" % (h.get("at", "")[:19], h.get("stage", "")))
    return 0


# --------------------------------------------------------------------------------- selftest


def cmd_selftest(args):
    import unittest
    tests_dir = PROJECT_ROOT / "tests"
    if not tests_dir.exists():
        err("no tests/ directory found at %s" % tests_dir)
        return 1
    sys.path.insert(0, str(tests_dir))
    sys.path.insert(0, str(PROJECT_ROOT / "cli"))
    loader = unittest.TestLoader()
    suite = loader.discover(str(tests_dir), pattern="test_*.py")
    verbosity = 2 if getattr(args, "verbose", False) else 1
    result = unittest.TextTestRunner(verbosity=verbosity).run(suite)
    if result.testsRun == 0:
        err("selftest discovered 0 tests — the suite is not being collected (a silent 'pass').")
        return 1
    return 0 if result.wasSuccessful() else 1


# ------------------------------------------------------------------------------------ main


def build_parser():
    p = argparse.ArgumentParser(prog="fuzzpipe", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_target(x):
        x.add_argument("--target", "-t", default=".", help="path to the Solidity project")

    def add_ptype(x):
        x.add_argument("--project-type", choices=["foundry", "hardhat"], default=None,
                       help="override project-type autodetection")

    sp = sub.add_parser("doctor", help="check installed tools (never crashes on a missing tool)")
    add_target(sp)
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("init", help="create run state for a target"); add_target(sp); add_ptype(sp)
    sp.set_defaults(func=cmd_init)

    sp = sub.add_parser("scaffold", help="generate Chimera harness"); add_target(sp); add_ptype(sp)
    sp.add_argument("--force", action="store_true", help="regenerate even if recon/ exists")
    sp.add_argument("--offline", action="store_true", help="skip network fetches; vendoring failures are non-fatal")
    sp.set_defaults(func=cmd_scaffold)

    sp = sub.add_parser("build", help="compile harness"); add_target(sp); add_ptype(sp)
    sp.set_defaults(func=cmd_build)

    sp = sub.add_parser("gen-handlers",
                        help="auto-generate a COMPLETE ABI-driven handler surface (run after build)")
    add_target(sp); add_ptype(sp)
    sp.add_argument("--contract", help="restrict generation to one contract type")
    sp.add_argument("--src", help="source dir for privileged-function detection (default src/ or contracts/)")
    sp.add_argument("--force", action="store_true", help="overwrite TargetFunctionsAuto.sol")
    sp.set_defaults(func=cmd_gen_handlers)

    sp = sub.add_parser("verify-harness", help="preflight: assert the engine discovers the harness")
    add_target(sp); add_ptype(sp)
    sp.set_defaults(func=cmd_verify_harness)

    sp = sub.add_parser("run", help="run the tiered ladder (or one --engine)"); add_target(sp); add_ptype(sp)
    sp.add_argument("--engine", "-e", choices=["medusa", "echidna", "foundry", "halmos"], default=None,
                    help="run a single engine (backward-compatible). Omit to run the tiered ladder.")
    sp.add_argument("--max-tier", type=int, default=1, help="highest ladder tier to run (0..2)")
    sp.add_argument("--depth", type=int, default=64, help="sequence length / depth")
    sp.add_argument("--limit", type=int, default=100000, help="test limit / runs")
    sp.add_argument("--budget", type=int, default=600, help="tier-1 wall-clock budget (seconds); "
                    "tier-0/2 come from .fuzzpipe/config.json `budgets` (defaults 60/900)")
    sp.add_argument("--property", help="focus a single property_* (foundry/halmos)")
    sp.add_argument("--regen-config", action="store_true", help="overwrite existing engine config")
    sp.add_argument("--workers", type=int, default=None,
                    help="Medusa internal worker (goroutine) count; default from config (%d)"
                    % DEFAULT_MEDUSA_WORKERS)
    sp.add_argument("--jobs", "-j", type=int, default=None,
                    help="max CONCURRENT campaigns in Tier-1 (per-invariant shards + engines); "
                    "default auto (cpu-2)")
    sp.add_argument("--no-parallel", action="store_true",
                    help="disable per-invariant fan-out; run one shared medusa campaign")
    sp.set_defaults(func=cmd_run)

    sp = sub.add_parser("triage", help="broken sequences -> type-aware reproducer + verdict gate")
    add_target(sp); add_ptype(sp)
    sp.set_defaults(func=cmd_triage)

    sp = sub.add_parser("verify", help="verdict gate on one PoC: compile+reproduce+harm -> CONFIRMED/SUSPECTED")
    add_target(sp)
    sp.add_argument("--ce", help="counterexample id (used as the invariant marker if --marker omitted)")
    sp.add_argument("--poc", help="path to the reproducer .t.sol (for the harm-assertion check)")
    sp.add_argument("--test", help="forge --match-test name (default: test_repro)")
    sp.add_argument("--marker", help="invariant-specific revert marker to require in the failure")
    sp.set_defaults(func=cmd_verify)

    sp = sub.add_parser("materiality",
                        help="sweep a reproducer across input scales: dust-only break => bad invariant (FP)")
    add_target(sp)
    sp.add_argument("--test", required=True, help="forge test fn that reads the amount from --env and asserts the invariant")
    sp.add_argument("--min", default="1", help="smallest sweep amount (int or 1e18 form; default 1)")
    sp.add_argument("--max", default="1e24", help="largest sweep amount (default 1e24)")
    sp.add_argument("--material", default="1e9",
                    help="materiality threshold in base units — smallest economically meaningful amount (default 1e9)")
    sp.add_argument("--env", default="FUZZPIPE_SWEEP_AMOUNT", help="env var the test reads the amount from")
    sp.add_argument("--budget", type=int, default=120, help="per-scale forge wall-clock budget (seconds)")
    sp.set_defaults(func=cmd_materiality)

    sp = sub.add_parser("ir", help="typed Invariant IR: put/get/list/validate/candidates/coverage-audit")
    add_target(sp); add_ptype(sp)
    sp.add_argument("action", choices=["put", "get", "list", "validate", "candidates", "coverage-audit"])
    sp.add_argument("--file", help="ir.json for `put`")
    sp.add_argument("--id", help="invariant id for `get`")
    sp.add_argument("--src", help="source dir for `coverage-audit` (default src/ or contracts/)")
    sp.add_argument("--waivers", help="waivers json for `coverage-audit` "
                    "(default .fuzzpipe/coverage-waivers.json)")
    sp.set_defaults(func=cmd_ir)

    sp = sub.add_parser("coverage", help="per-function coverage + uncovered-entry-point flags")
    sp.add_argument("--gate", action="store_true",
                    help="blocking gate: fail (exit 2) on unwaived uncovered entry points or <--min-pct")
    sp.add_argument("--min-pct", type=int, default=0,
                    help="minimum in-scope line %% required by --gate (default 0 = MISS-only)")
    add_target(sp)
    sp.add_argument("--engine", "-e", choices=["medusa", "echidna"], default="medusa")
    sp.set_defaults(func=cmd_coverage)

    sp = sub.add_parser("status", help="show pipeline state"); add_target(sp)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("selftest", help="run the shipped regression suite (zero deps)")
    sp.add_argument("--verbose", "-v", action="store_true")
    sp.set_defaults(func=cmd_selftest)

    return p


def main():
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
