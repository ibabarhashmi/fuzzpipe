# ----------------------------------------------------- engine config generation


def _tester_rel_path(target):
    for cand in ("test/recon/CryticTester.sol", "contracts/recon/CryticTester.sol",
                 "test/CryticTester.sol", "src/CryticTester.sol"):
        if (Path(target) / cand).exists():
            return cand
    for p in Path(target).rglob("CryticTester.sol"):
        if "lib/" not in str(p):
            return str(p.relative_to(target))
    return "test/recon/CryticTester.sol"


def _disable_slither_for_hh3(target, pt):
    return pt == "hardhat" and (_hardhat_major(target) or 2) >= 3


def _medusa_config_dict(target, depth, limit, pt, corpus, targets=None, workers=None):
    d = {
        "fuzzing": {
            "workers": _medusa_workers(target, workers),
            "testLimit": int(limit), "callSequenceLength": int(depth),
            "corpusDirectory": corpus,
            "deploymentOrder": targets or ["CryticTester"],
            "targetContracts": targets or ["CryticTester"],
            "testChainConfig": {"codeSizeCheckDisabled": True},
        },
        "compilation": {"platform": "crytic-compile",
                        "platformConfig": {"target": _tester_rel_path(target), "solcVersion": ""}},
        "testing": {"stopOnFailedTest": True, "testAllContracts": False,
                    "assertionTesting": {"enabled": True},
                    "propertyTesting": {"enabled": True, "testPrefix": "property_"},
                    "optimizationTesting": {"enabled": False}},
    }
    if _disable_slither_for_hh3(target, pt):
        d["slither"] = {"useSlither": False}
    return d


def _write_medusa_config(target, depth, limit, force=False, pt=None, workers=None):
    cfg = Path(target) / "medusa.json"
    if cfg.exists() and not force:
        return cfg
    cfg.write_text(json.dumps(
        _medusa_config_dict(target, depth, limit, pt, ".fuzzpipe/corpus/medusa", workers=workers),
        indent=2))
    info("wrote medusa.json (compile target: %s)" % _tester_rel_path(target))
    return cfg


def _stage_medusa_config_for_invariant(target, inv_id, depth, limit, pt=None, workers=None):
    """Per-shard staged medusa.json with its OWN corpus dir, keyed by invariant id, written under
    .fuzzpipe/medusa/<INV>.json. Two properties this buys:
      * Isolation — one shard's corpus/`stopOnFailedTest` never disturbs another's, so a break in
        one shard can't cut short the others, and `triage` can attribute a failing sequence to the
        shard (invariant) it came from via its own test_results dir.
      * Parallel breadth — N shards run concurrently (see `cmd_run`), so within one wall-clock
        budget the fleet explores ~N× the sequences a single process would, diversified by
        independent corpora. The first shard to surface a counterexample short-circuits to triage.
    """
    out = state_dir(target) / "medusa" / (inv_id + ".json")
    out.parent.mkdir(parents=True, exist_ok=True)
    # medusa resolves a --config file's RELATIVE paths against the CONFIG's directory, not the
    # project root, so a staged config under .fuzzpipe/medusa/ must use ABSOLUTE paths for both the
    # compile target and the corpus dir (else crytic-compile can't find the harness). The corpus dir
    # stays under state_dir so `triage` (which reads state_dir/corpus/medusa/<INV>/test_results)
    # still finds this shard's failing sequences.
    corpus = str(state_dir(target) / "corpus" / "medusa" / inv_id)
    cfg = _medusa_config_dict(target, depth, limit, pt, corpus, workers=workers)
    cfg["compilation"]["platformConfig"]["target"] = str(Path(target) / _tester_rel_path(target))
    out.write_text(json.dumps(cfg, indent=2))
    return out


def _write_echidna_config(target, depth, limit, force=False, pt=None):
    cfg = Path(target) / "echidna.yaml"
    if cfg.exists() and not force:
        return cfg
    cfg.write_text("testMode: assertion\ntestLimit: %d\nseqLen: %d\n"
                   "corpusDir: .fuzzpipe/corpus/echidna\ncoverage: true\n" % (int(limit), int(depth)))
    info("wrote echidna.yaml")
    return cfg


