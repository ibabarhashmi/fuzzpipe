def cmd_verify_harness(args):
    """Assert the engine can actually SEE the harness before a campaign is spent (avoids the
    'harness written where the engine never looks' class). Foundry: CryticTester compiles and
    forge lists the reproducer contract. Medusa/crytic: the tester path resolves."""
    target = Path(args.target).resolve()
    pt = _project_type(target, getattr(args, "project_type", None))
    tester = Path(target) / _tester_rel_path(target)
    problems = []
    if not tester.exists():
        problems.append("CryticTester.sol not found at the expected path (%s)" % _tester_rel_path(target))
    else:
        ok("harness entrypoint present: %s" % tester.relative_to(target))
    if have("forge"):
        code, out = run_cmd(["forge", "build"], cwd=str(target), stream=False, timeout=600)
        if code != 0:
            problems.append("forge build failed - the engine would not compile this harness")
        else:
            ok("forge build succeeds - Foundry discovers the harness")
    else:
        warn("forge absent - cannot run the compile preflight (install forge).")
    if problems:
        for p in problems:
            err(p)
        warn("Harness is NOT campaign-ready. Fix the above before `run` (a silently-undiscovered "
             "harness would report every invariant UNTESTED while looking like it ran).")
        set_stage(target, "3-verify-harness", harness_ready=False)
        return 1
    ok("Harness discovery preflight passed.")
    set_stage(target, "3-verify-harness", harness_ready=True)
    return 0


# ------------------------------------------------------------------------------------ run (ladder)


def _engine_missing(engine, pt):
    """Tools that must be present for `engine` (honoring the Hardhat variant). Empty == ready."""
    key = ("run-%s-hardhat" % engine) if (pt == "hardhat" and ("run-%s-hardhat" % engine) in CORE_FOR) else ("run-%s" % engine)
    return [t for t in CORE_FOR.get(key, []) if not have(TOOLS[t][0])]


def _classify_rc(engine, rc, budget_s):
    """Map a run_bounded rc to a ladder status.

    A fuzzer that runs its whole wall-clock budget without self-terminating found NO counterexample
    (medusa/echidna exit fast and non-zero on a real break via stopOnFailedTest), so a TIMEOUT is
    'no-CE-in-budget' (clean), NOT a break — conflating the two produces false candidate breaks."""
    if rc == proc.RC_TIMEOUT:
        info("%s ran its full %ss budget with no counterexample (report as 'held under budget', not 'safe')." % (engine, budget_s))
        return "clean"
    if rc == proc.RC_MISSING:
        return "untested"
    return "clean" if rc == 0 else "break_or_error"


def _run_engine(target, engine, pt, depth, limit, budget_s, regen=False, prop=None, workers=None):
    """Run one engine under a REAL wall-clock budget. Returns (status, rc). status in
    {clean, break_or_error, untested}. Never raises; a missing engine -> untested."""
    missing = _engine_missing(engine, pt)
    if missing:
        warn("Tier engine `%s` unavailable (missing: %s) -> UNTESTED for this tier." % (engine, ", ".join(missing)))
        return "untested", proc.RC_MISSING
    if engine == "foundry":
        cmd = ["forge", "test", "--match-contract", "CryticToFoundry"]
        if prop:
            cmd += ["--match-test", prop]
    elif engine == "medusa":
        _write_medusa_config(target, depth, limit, force=regen, pt=pt, workers=workers)
        cmd = ["medusa", "fuzz"]
    elif engine == "echidna":
        _write_echidna_config(target, depth, limit, force=regen, pt=pt)
        cmd = ["echidna", _tester_rel_path(target), "--contract", "CryticTester", "--config", "echidna.yaml"]
    elif engine == "halmos":
        cmd = ["halmos"]
        if prop:
            cmd += ["--function", prop]
    else:
        return "untested", 1
    info("Running %s (depth=%s limit=%s budget=%ss) ..." % (engine, depth, limit, budget_s))
    rc, out = proc.run_bounded(cmd, budget_s, cwd=str(target))
    (state_dir(target) / "runs" / engine).mkdir(parents=True, exist_ok=True)
    (state_dir(target) / "runs" / engine / "last.log").write_text(out or "")
    return _classify_rc(engine, rc, budget_s), rc


def _approved_or_candidate_ids(target):
    """Invariant ids eligible to shard a fuzzing campaign: approved first (post-checkpoint), else
    candidates. Empty if no IR — the caller then runs a single un-sharded campaign."""
    invs = irmod.load(state_dir(target) / "invariants.json")
    approved = [i.id for i in invs if i.status == "approved"]
    if approved:
        return approved
    return [i.id for i in invs if i.status == "candidate"]


def _shard_has_breaks(target, shard):
    """True iff a medusa shard actually wrote failing sequences. `shard` is an invariant id, or
    None for the flat (single-campaign) corpus."""
    base = state_dir(target) / "corpus" / "medusa"
    tr = (base / "test_results") if shard is None else (base / shard / "test_results")
    return tr.is_dir() and any(tr.glob("*.json"))


def _run_tier1(target, pt, depth, limit, budget_s, regen, workers, jobs, parallel):
    """Tier-1 (medusa + echidna) with concurrency. Returns (results_dict, broke_bool).

    Two axes of parallelism, both via one bounded pool (proc.run_many_bounded):
      * medusa + echidna run CONCURRENTLY (they share the harness but write to separate
        corpus/runs dirs, so there is no contention).
      * medusa itself fans out into per-invariant shards when the IR has >= 2 eligible
        invariants and parallelism is enabled — each shard its own staged config + corpus dir.
    Each child keeps its OWN wall-clock budget; the first medusa shard to break short-circuits
    the ladder (the others are still allowed to finish their in-flight budget).
    """
    specs = []   # (engine, shard_id_or_None, cmd)
    # ---- medusa jobs ----
    if _engine_missing("medusa", pt):
        warn("Tier engine `medusa` unavailable (missing: %s) -> UNTESTED for this tier."
             % ", ".join(_engine_missing("medusa", pt)))
        results_medusa_untested = True
    else:
        results_medusa_untested = False
        ids = _approved_or_candidate_ids(target) if parallel else []
        if parallel and len(ids) >= 2:
            info("Per-invariant parallel fan-out: %d medusa shards (own corpus each)." % len(ids))
            for inv_id in ids:
                cfg = _stage_medusa_config_for_invariant(target, inv_id, depth, limit, pt=pt, workers=workers)
                specs.append(("medusa", inv_id, ["medusa", "fuzz", "--config", str(cfg)]))
        else:
            _write_medusa_config(target, depth, limit, force=regen, pt=pt, workers=workers)
            specs.append(("medusa", None, ["medusa", "fuzz"]))
    # ---- echidna job (crosscheck) ----
    if _engine_missing("echidna", pt):
        warn("Tier engine `echidna` unavailable (missing: %s) -> UNTESTED for this tier."
             % ", ".join(_engine_missing("echidna", pt)))
        results_echidna_untested = True
    else:
        results_echidna_untested = False
        _write_echidna_config(target, depth, limit, force=regen, pt=pt)
        specs.append(("echidna", None,
                      ["echidna", _tester_rel_path(target), "--contract", "CryticTester",
                       "--config", "echidna.yaml"]))

    results = {}
    if results_medusa_untested:
        results["medusa(t1)"] = "untested"
    if results_echidna_untested:
        results["echidna(t1)"] = "untested"
    if not specs:
        return results, False

    pool = jobs or proc.default_jobs(len(specs))
    info("Tier-1: dispatching %d campaign(s) concurrently (pool=%d, budget=%ss each) ..."
         % (len(specs), min(pool, len(specs)), budget_s))
    jobspecs = [{"key": (eng, shard), "cmd": cmd, "timeout_s": budget_s, "cwd": str(target)}
                for (eng, shard, cmd) in specs]
    outcomes = proc.run_many_bounded(jobspecs, max_workers=pool)

    broke = False
    for (eng, shard), rc, out in outcomes:
        sub = eng if shard is None else "%s/%s" % (eng, shard)
        rundir = state_dir(target) / "runs" / eng / (shard or "")
        rundir.mkdir(parents=True, exist_ok=True)
        (rundir / "last.log").write_text(out or "")
        status = _classify_rc(eng, rc, budget_s)
        if eng == "medusa" and status == "break_or_error" and not _shard_has_breaks(target, shard):
            # non-zero exit but NO failing sequence written -> an engine/compile error, not a
            # counterexample. Never let that masquerade as a break (see the shard's last.log).
            warn("medusa shard %s exited non-zero but wrote no failing sequence -> ERROR, not a break "
                 "(check runs/medusa/%s/last.log)." % (sub, shard or ""))
            status = "untested"
        label = "%s(t1)" % eng if shard is None else "%s:%s(t1)" % (eng, shard)
        results[label] = status
        if status == "break_or_error":
            broke = True
            info("shard %s surfaced a candidate break (failing sequence written)." % sub)
    return results, broke


def cmd_run(args):
    target = Path(args.target).resolve()
    pt = _project_type(target, getattr(args, "project_type", None))
    _compile_harness(target, pt)

    workers = getattr(args, "workers", None)
    jobs = getattr(args, "jobs", None)
    parallel = not getattr(args, "no_parallel", False)

    # backward-compatible single-engine mode
    if args.engine:
        if pt == "hardhat" and args.engine == "foundry":
            err("the `foundry` engine needs Foundry test wiring; on Hardhat use medusa/echidna.")
            return 1
        status, rc = _run_engine(target, args.engine, pt, args.depth, args.limit,
                                 args.budget, regen=args.regen_config, prop=args.property,
                                 workers=workers)
        set_stage(target, "4-run", engine=args.engine, result=status)
        if status == "clean":
            ok("%s finished with no property break (record coverage - NOT proof of safety)." % args.engine)
        elif status == "untested":
            warn("%s did not run (engine unavailable)." % args.engine)
        else:
            warn("%s reported a break or error. Run `fuzzpipe triage` next." % args.engine)
        return 0 if status != "break_or_error" else rc

    # tiered ladder (counterexample-first). Escalate only on 'no counterexample in budget'.
    budgets = _ladder_budgets(target, args.budget)
    tiers = [(0, ["foundry"]), (1, ["medusa", "echidna"]), (2, ["halmos"])]
    max_tier = args.max_tier
    results = {}
    for tier, engines in tiers:
        if tier > max_tier:
            break
        if tier == 2 and not symbolic_enabled():
            info("Tier-2 (halmos) skipped: eval-gated (set %s=1 for critical bounded SAFETY/CORRECTNESS)." % ENV_SYMBOLIC)
            continue
        if tier == 1:
            # Tier-1 runs medusa (optionally per-invariant sharded) + echidna CONCURRENTLY.
            tier_results, broke = _run_tier1(target, pt, args.depth, args.limit, budgets[1],
                                             args.regen_config, workers, jobs, parallel)
            results.update(tier_results)
        else:
            broke = False
            for engine in engines:
                status, rc = _run_engine(target, engine, pt, args.depth, args.limit, budgets[tier],
                                         regen=args.regen_config, workers=workers)
                results["%s(t%d)" % (engine, tier)] = status
                if status == "break_or_error":
                    broke = True
        if broke:
            warn("Tier-%d surfaced a candidate break -> stop escalating; run `fuzzpipe triage` (the verdict gate)." % tier)
            break
    set_stage(target, "4-run", ladder=results)
    print(c("\nLadder result:", "bold"))
    for k, v in results.items():
        print("  %-18s %s" % (k, v))
    if not any(v == "break_or_error" for v in results.values()):
        # HARD coverage gate: a 'held under budget' verdict is only trustworthy if the campaign
        # actually reached the code. Block the NO-CE verdict when in-scope coverage is missing an
        # unwaived entry point (or is below the configured floor). This closes the Stage-4 -> Stage-3
        # loop mechanically instead of leaving it to advisory prose.
        waivers = _load_waivers(target, None)
        min_pct = _min_pct_config(target)
        pass_eng = None
        for eng in ("medusa", "echidna"):
            available, passed, reasons = _coverage_gate(target, eng, min_pct, waivers)
            if not available:
                continue
            if not passed:
                warn("COVERAGE GATE FAILED (%s) — this run CANNOT be reported as 'held under budget':" % eng)
                for r in reasons:
                    print("    - " + r)
                warn("Complete the call surface (`fuzzpipe gen-handlers`), loosen clamps, or record a "
                     "justified waiver in .fuzzpipe/coverage-waivers.json — then re-run.")
                set_stage(target, "4-run", ladder=results, coverage_gate="fail")
                return 2
            pass_eng = eng
            break
        if pass_eng:
            scope, _ = _coverage_scan(target, pass_eng)
            ok("No counterexample within budget; coverage gate PASSED at %d%% in-scope lines "
               "(report as 'held under budget', NOT 'safe')." % (_overall_pct(scope) if scope else 0))
        else:
            ok("No counterexample within budget. Report as 'held under budget at C% coverage' - NOT "
               "'safe'. (No coverage lcov yet — run medusa/echidna with coverage to enforce the gate.)")
    return 0


# --------------------------------------------------------------------------------- triage (gate)


def _medusa_results_dirs(target):
    """Every place a Medusa run may have written failing sequences: the flat single-run dir AND
    each per-invariant shard's own dir (.fuzzpipe/corpus/medusa/<INV>/test_results). Fixes the
    v2.1 bug where a per-invariant (sharded) run wrote under <INV>/test_results but triage only
    ever looked at the flat corpus/medusa/test_results and silently found nothing."""
    base = state_dir(target) / "corpus" / "medusa"
    dirs = []
    flat = base / "test_results"
    if flat.is_dir():
        dirs.append(flat)
    if base.is_dir():
        for shard in sorted(base.iterdir()):
            if shard.is_dir() and shard.name != "test_results":
                tr = shard / "test_results"
                if tr.is_dir():
                    dirs.append(tr)
    return dirs


def _collect_medusa_sequences(target):
    """Merge failing sequences across the flat dir and every shard dir. Shard sequences are
    tagged with the invariant id so a finding can be attributed to the shard it came from."""
    sequences, warnings = [], []
    for d in _medusa_results_dirs(target):
        seqs, warns = medusa_parse.failing_sequences(d)
        # d.parent.name is the shard id (invariant) for shard dirs, "medusa" for the flat dir
        shard = d.parent.name if d.parent.name != "medusa" else None
        for fname, seq in seqs:
            tag = ("%s::%s" % (shard, fname)) if shard else fname
            sequences.append((tag, seq))
        warnings += warns
    return sequences, warnings


def cmd_triage(args):
    target = Path(args.target).resolve()
    pt = _project_type(target, getattr(args, "project_type", None))
    sequences, warnings = _collect_medusa_sequences(target)
    for w in warnings:                          # Q6: surface drift, never silently drop
        warn(w)
    if not sequences:
        base = state_dir(target) / "corpus" / "medusa"
        warn("no Medusa failing-sequence artifacts under %s (checked the flat dir and every shard)." % base)
        print("  Run `fuzzpipe run --engine medusa` first; triage reads its broken sequences.")
        set_stage(target, "5-triage", triage="no_artifacts")
        return 1

    if pt == "hardhat":
        import_line = 'import {CryticToFoundry} from "./CryticToFoundry.sol";'
        repro = verdict.render_reproducer_contract(sequences, import_line)
        out = target / "foundry-repro" / "MedusaReproducers.t.sol"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(repro)
        ok("Wrote %d reproducer(s) to %s (byte-exact Foundry replay for a Hardhat target)." % (len(sequences), out))
        info("Add the HARM assertion, then run the verdict gate with `forge test` from the foundry-repro context.")
        set_stage(target, "5-triage", triage="hardhat_repro", reproducers=len(sequences))
        return 0

    # Foundry path: type-aware reproducer (Q2/Q3 fix - bool/array/tuple no longer crash)
    info("Lowering broken sequences into a Foundry reproducer (type-aware rendering)...")
    import_line = 'import {CryticToFoundry} from "./recon/CryticToFoundry.sol";'
    repro = verdict.render_reproducer_contract(sequences, import_line)
    out = target / "test" / "MedusaReproducers.t.sol"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(repro)
    ok("Wrote %d reproducer test(s) to %s" % (len(sequences), out))

    # verdict gate (best-effort re-execution). CONFIRMED needs a hand-added HARM assertion, so a
    # freshly-generated reproducer is expected to be SUSPECTED until the skill asserts the harm.
    if have("forge"):
        info("Re-executing reproducers (verdict gate)...")
        rc, gout = verdict.forge_build(target)
        if rc != 0:
            warn("reproducer did not compile -> SUSPECTED (fix the harness/rendering, or the sequence is unrenderable).")
            set_stage(target, "5-triage", triage="suspected_no_compile", reproducers=len(sequences))
            return 0
        rc, gout = verdict.forge_test(target, "test_repro", 300)
        broke = "[FAIL" in (gout or "")
        if broke:
            ok("Reproducer triggered a break. Now add the HARM assertion, then `fuzzpipe verify` "
               "to promote it to CONFIRMED (a break without a harm assertion stays SUSPECTED).")
        else:
            warn("Reproducers ran without a break - re-check the sequence/harness (SUSPECTED).")
    else:
        warn("forge absent - wrote the reproducer but cannot re-execute it. Verdict: SUSPECTED until re-run.")
    set_stage(target, "5-triage", triage="native_ok", reproducers=len(sequences))
    info("Classify each break: real bug / bad invariant (Stage 2) / bad harness (Stage 3). "
         "See guidance/04 + guidance/05.")
    return 0


